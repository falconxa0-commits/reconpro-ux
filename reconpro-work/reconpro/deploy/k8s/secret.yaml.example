# =============================================================================
# ReconPro v11 Enterprise — Kubernetes Secret (TEMPLATE)
# =============================================================================
#
# ⚠️  DO NOT COMMIT THIS FILE WITH REAL SECRETS!
#
# This is an example template. Generate your own secret as follows:
#
#   1. Generate a secure bootstrap secret:
#      BOOTSTRAP_SECRET=$(openssl rand -hex 32)
#
#   2. Create the Kubernetes Secret:
#      kubectl create secret generic reconpro-secrets \
#        --namespace=reconpro \
#        --from-literal=RECONPRO_BOOTSTRAP_SECRET="$BOOTSTRAP_SECRET" \
#        --dry-run=client -o yaml > k8s/secret.yaml
#
#   3. Apply the secret:
#      kubectl apply -f k8s/secret.yaml
#
#   4. Store the bootstrap secret securely (e.g., in your password manager
#      or a dedicated secrets manager like HashiCorp Vault).
#
# Verify the secret is created:
#   kubectl get secret reconpro-secrets -n reconpro
#
# The bootstrap secret is used to authenticate initial API token generation:
#   curl -X POST http://localhost:7890/auth/token \
#     -H "Content-Type: application/json" \
#     -d '{"bootstrap_secret": "<YOUR_SECRET>", "label": "prod-token", "hours": 720}'
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: reconpro-secrets
  namespace: reconpro
  labels:
    app.kubernetes.io/name: reconpro-api
    app.kubernetes.io/instance: reconpro-enterprise
    app.kubernetes.io/component: secrets
    app.kubernetes.io/part-of: reconpro
    environment: production
  annotations:
    # Encourage Kubernetes to not log the secret contents
    kubernetes.io/created-by: "manual"
type: Opaque
# ── IMPORTANT: Replace the placeholder below with a real secret! ───────────
data:
  # Base64-encoded bootstrap secret. Generate with:
  #   echo -n 'your-secure-random-secret-here' | base64
  RECONPRO_BOOTSTRAP_SECRET: "REPLACE_WITH_BASE64_ENCODED_SECRET"
# ─────────────────────────────────────────────────────────────────────────────
# Example workflow:
#
#   SECRET=$(openssl rand -hex 32) && \
#   ENCODED=$(echo -n "$SECRET" | base64) && \
#   sed "s/REPLACE_WITH_BASE64_ENCODED_SECRET/$ENCODED/" k8s/secret.yaml.example > k8s/secret.yaml && \
#   echo "Bootstrap secret (save this!): $SECRET"
#
# Then apply:
#   kubectl apply -f k8s/secret.yaml
