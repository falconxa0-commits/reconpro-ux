# ─── ReconPro Production Environment Variables ─────────────────────────
# Copy this file to .env and fill in the values for your deployment.

# ── Application ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── Database ────────────────────────────────────────────────────────────
# SQLite (default — file-based, no external DB needed)
DATABASE_URL=file:/app/db/reconpro.db

# PostgreSQL (alternative — for multi-instance deployments)
# DATABASE_URL=postgresql://reconpro:your_password@localhost:5432/reconpro

# ── Authentication ──────────────────────────────────────────────────────
# Session secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your-64-character-random-hex-string-here

# ── Scanner Engine ──────────────────────────────────────────────────────
# Maximum concurrent scan operations
SCAN_CONCURRENCY=5

# Scanner timeout in milliseconds
SCAN_TIMEOUT=60000

# ── Rate Limiting ───────────────────────────────────────────────────────
# API rate limit (requests per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Optional: External Integrations ─────────────────────────────────────
# Slack webhook URL (for alert notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Optional: Email (for password reset, invitations) ───────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=noreply@reconpro.dev

# ── Optional: Analytics ────────────────────────────────────────────────
# ANALYTICS_ID=your-analytics-id
