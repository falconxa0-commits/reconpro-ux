generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// RECONPRO ENTERPRISE SCHEMA — Billion-Dollar Grade
// ═══════════════════════════════════════════════════════════════════════

// ── Organization & Team Management ──────────────────────────────────

model Organization {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  plan          String       @default("enterprise") // starter, professional, enterprise
  logo          String?
  domain        String?      // primary monitored domain
  maxScans      Int          @default(1000)
  maxMembers    Int          @default(50)
  ssoEnabled    Boolean      @default(false)
  apiQuota      Int          @default(10000)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teams          Team[]
  members        Member[]
  scanTargets   ScanTarget[]
  monitorPolicies MonitorPolicy[]
  integrations  Integration[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  genesisStamps  GenesisStamp[]
}

model Team {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  color          String        @default("#00ff88")
  createdAt      DateTime      @default(now())
  members        TeamMember[]
  scanTargets    ScanTarget[]
}

model Member {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  email          String
  name           String
  avatar         String?
  role           String        @default("analyst") // owner, admin, security_lead, analyst, viewer
  lastActive     DateTime?
  createdAt      DateTime      @default(now())
  teamMemberships TeamMember[]
  auditLogs      AuditLog[]
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  role        String   @default("member") // lead, member
  joinedAt    DateTime @default(now())
}

// ── Scan Engine (enhanced) ─────────────────────────────────────────

model ScanTarget {
  id             String           @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id])
  domain         String
  ip             String?
  tags           String           @default("[]") // JSON array of tags
  importance     String           @default("normal") // critical, high, normal, low
  lastScanned    DateTime?
  createdAt      DateTime         @default(now())
  scans          Scan[]
  monitorPolicies MonitorPolicy[]
}

model Scan {
  id              String        @id @default(cuid())
  targetId        String
  target          ScanTarget    @relation(fields: [targetId], references: [id])
  status          String        @default("pending") // pending, running, completed, failed
  scanType        String        @default("full")    // full, quick, stealth, compliance
  triggeredBy     String        @default("manual") // manual, scheduled, api, webhook
  triggeredById   String?
  riskScore       Int           @default(0)
  totalVulns      Int           @default(0)
  criticalCount   Int           @default(0)
  highCount       Int           @default(0)
  mediumCount     Int           @default(0)
  lowCount        Int           @default(0)
  infoCount       Int           @default(0)
  complianceScore Int           @default(0)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  duration        Int?          // scan duration in ms
  findings        Finding[]
}

model Finding {
  id            String   @id @default(cuid())
  scanId        String
  scan          Scan     @relation(fields: [scanId], references: [id])
  title         String
  severity      String   // critical, high, medium, low, info
  category      String   // subdomain, port, technology, ssl, dns, header, vulnerability
  description   String
  evidence      String?
  asset         String
  remediation  String?  // fix guidance
  cve           String?  // CVE ID if applicable
  cvss          Float?   // CVSS score
  status        String   @default("open") // open, acknowledged, mitigated, false_positive
  createdAt     DateTime @default(now())
}

model ThreatAlert {
  id          String   @id @default(cuid())
  title       String
  severity    String
  source      String
  description String
  ioc         String?
  createdAt   DateTime @default(now())
}

// ── Compliance Framework ──────────────────────────────────────────

model ComplianceReport {
  id              String   @id @default(cuid())
  organizationId  String
  framework       String  // soc2, hipaa, pci_dss, iso27001, gdpr, nist
  scanId          String?
  overallScore    Int     @default(0) // 0-100
  status          String  @default("in_progress") // pass, fail, in_progress, needs_review
  controls        String  @default("[]") // JSON array of control checks
  generatedAt     DateTime @default(now())
}

// ── Continuous Monitoring ────────────────────────────────────────────

model MonitorPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  targetId       String
  target         ScanTarget  @relation(fields: [targetId], references: [id])
  name           String
  schedule       String      @default("daily") // hourly, daily, weekly, monthly
  scanType       String      @default("full")
  enabled        Boolean     @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  totalRuns      Int          @default(0)
  createdAt      DateTime    @default(now())
}

// ── Integrations ───────────────────────────────────────────────────

model Integration {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String        // slack, jira, splunk, pagerduty, microsoft_teams, webhooks, email
  name           String
  config         String        // JSON config
  enabled        Boolean       @default(true)
  lastSync       DateTime?
  eventsTotal    Int           @default(0)
  createdAt      DateTime      @default(now())
}

// ── API Key Management ──────────────────────────────────────────────

model ApiKey {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyHash        String      @unique  // SHA-256 hash of the API key
  keyPrefix      String              // First 12 chars for display (e.g., "rp_sk_live_")
  name           String              // Human-readable label
  scopes         String      @default("[\"scan:read\",\"scan:write\",\"telemetry:write\"]")  // JSON array
  lastUsedAt     DateTime?
  requestCount   Int         @default(0)
  isActive       Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  auditLogs      AuditLog[]
}

// ── Audit & Governance ──────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  memberId       String?
  member         Member?     @relation(fields: [memberId], references: [id])
  apiKeyId       String?
  apiKey         ApiKey?     @relation(fields: [apiKeyId], references: [id])
  action         String      // scan_launched, finding_acknowledged, member_invited, etc.
  resource       String      // scan, finding, member, team, policy
  resourceId     String?
  details        String?     // JSON
  ipAddress      String?
  createdAt      DateTime    @default(now())
}

// ── VibeSec Hall of Fame ──────────────────────────────────────────────

model VibeSecEntry {
  id          String    @id @default(cuid())
  domain      String    @unique
  score       Int
  grade       String
  findings    Int
  submittedBy String?
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  category    String    @default("other")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

// ── NHI Kill-Switch & Remediation ────────────────────────────────────

model NHIIdentity {
  id              String   @id @default(cuid())
  organizationId  String
  identityType    String   // aws_iam_role, aws_iam_user, gcp_service_account, azure_app_registration, github_pat, etc.
  identifier      String   // ARN, email, client ID, etc.
  displayName     String?
  cloudProvider   String   // aws, gcp, azure, github
  permissions     String   @default("[]") // JSON array of permission strings
  lastRotated     DateTime?
  status          String   @default("active") // active, revoked, expired, suspect
  riskLevel       String   @default("normal") // critical, high, normal, low
  blastRadius     Int      @default(0) // number of reachable resources
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  revocations     NHIRevocation[]
}

model NHIRevocation {
  id              String   @id @default(cuid())
  organizationId  String
  identityId      String
  identity        NHIIdentity @relation(fields: [identityId], references: [id])
  reason          String   // breach_detected, policy_violation, manual, scheduled_rotation, false_positive
  revokedBy       String?  // who triggered it
  cloudProvider   String
  identityType    String
  identifier      String
  permissions     String   // snapshot of permissions at time of revocation
  status          String   @default("completed") // pending, completed, failed, rolled_back
  errorMessage     String?
  rollbackData    String?  // JSON — data needed to reinstate
  executedAt      DateTime @default(now())
  rolledBackAt    DateTime?
  auditLog        NHIAuditLog[]
}

model NHIAuditLog {
  id              String   @id @default(cuid())
  organizationId  String
  revocationId    String?
  revocation      NHIRevocation? @relation(fields: [revocationId], references: [id])
  action          String   // identity_scan, revocation_started, revocation_completed, rollback_started, rollback_completed
  resource        String   // identity, revocation, policy
  resourceId       String?
  details         String?  // JSON
  ipAddress        String?
  timestamp       DateTime @default(now())
}

model NHIImpactAssessment {
  id              String   @id @default(cuid())
  organizationId  String
  targetIdentityId String?
  scope           String   // single, team, org, multi_cloud
  affectedIdentities Int      @default(0)
  affectedResources  Int      @default(0)
  riskBefore       Int      @default(0)
  riskAfter        Int      @default(0)
  status          String   @default("draft") // draft, approved, executed
  createdAt       DateTime @default(now())
  executedAt      DateTime?
}

// ── Genesis Stamp (Cryptographic Attestation) ───────────────────────

model GenesisStamp {
  id              String   @id @default(cuid())
  stampId         String   @unique          // human-readable: GS-XXXX-XXXX-XXXX
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  domain          String                    // audited domain
  tier            String   @default("basic") // basic, professional, enterprise
  score           Int                       // 0-100 aggregate security score
  grade           String                    // A+ to F
  scanId          String?                   // source scan
  complianceScores String  @default("{}")   // JSON: { soc2: 92, hipaa: 88, ... }
  findingsSummary String  @default("{}")   // JSON: { critical: 0, high: 2, medium: 5, ... }
  frameworks      String   @default("[]")   // JSON: ["soc2", "hipaa", ...]
  signature       String                    // Ed25519 signature (base64)
  publicKey       String                    // Ed25519 public key (hex)
  payloadHash     String                    // SHA-256 of the attestation payload
  status          String   @default("active") // active, expired, revoked
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokeReason    String?
  verifiedCount   Int      @default(0)      // times the verification API was hit
  embedViews      Int      @default(0)      // times the badge was rendered
  auditTrails     GenesisAuditTrail[]
}

model GenesisAuditTrail {
  id          String   @id @default(cuid())
  stampId     String
  stamp       GenesisStamp @relation(fields: [stampId], references: [id])
  action      String   // issued, verified, renewed, revoked, embedded
  ipAddress   String?
  userAgent   String?
  details     String?  // JSON
  createdAt   DateTime @default(now())
}

// ── Proof-of-Implosion (Executive Risk Simulator) ──────────────────

model ImplosionScenario {
  id              String   @id @default(cuid())
  organizationId  String?
  domain          String?
  scanId          String?
  industry        String   @default("technology") // healthcare, finance, technology, retail, government, education
  companyName     String?
  annualRevenue   Float?              // in millions USD
  employeeCount   Int?
  customerCount   Int?
  // Impact Calculations
  dataBreachCost       Float?     // estimated total cost in millions
  regulatoryFines       Float?     // total fines in millions
  reputationalDamage   Float?     // estimated brand damage in millions
  operationalDowntime  Float?     // hours of downtime
  customerChurnRate    Float?     // percentage of customers lost
  stockImpactPct       Float?     // stock price drop percentage
  insurancePremiumIncrease Float?  // premium increase percentage
  // Simulation config
  scenarioName    String   @default("Full Breach Simulation")
  severityPreset  String   @default("moderate") // minimal, moderate, severe, catastrophic
  customFactors   String   @default("{}")    // JSON: user-tweaked multipliers
  createdAt       DateTime @default(now())
}
