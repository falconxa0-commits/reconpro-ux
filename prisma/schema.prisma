generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// RECONPRO ENTERPRISE SCHEMA — Billion-Dollar Grade
// ═══════════════════════════════════════════════════════════════════════

// ── Organization & Team Management ──────────────────────────────────

model Organization {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  plan          String       @default("enterprise") // starter, professional, enterprise
  logo          String?
  domain        String?      // primary monitored domain
  maxScans      Int          @default(1000)
  maxMembers    Int          @default(50)
  ssoEnabled    Boolean      @default(false)
  apiQuota      Int          @default(10000)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teams          Team[]
  members        Member[]
  scanTargets   ScanTarget[]
  monitorPolicies MonitorPolicy[]
  integrations  Integration[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
}

model Team {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  color          String        @default("#00ff88")
  createdAt      DateTime      @default(now())
  members        TeamMember[]
  scanTargets    ScanTarget[]
}

model Member {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  email          String
  name           String
  avatar         String?
  role           String        @default("analyst") // owner, admin, security_lead, analyst, viewer
  lastActive     DateTime?
  createdAt      DateTime      @default(now())
  teamMemberships TeamMember[]
  auditLogs      AuditLog[]
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  role        String   @default("member") // lead, member
  joinedAt    DateTime @default(now())
}

// ── Scan Engine (enhanced) ─────────────────────────────────────────

model ScanTarget {
  id             String           @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id])
  domain         String
  ip             String?
  tags           String           @default("[]") // JSON array of tags
  importance     String           @default("normal") // critical, high, normal, low
  lastScanned    DateTime?
  createdAt      DateTime         @default(now())
  scans          Scan[]
  monitorPolicies MonitorPolicy[]
}

model Scan {
  id              String        @id @default(cuid())
  targetId        String
  target          ScanTarget    @relation(fields: [targetId], references: [id])
  status          String        @default("pending") // pending, running, completed, failed
  scanType        String        @default("full")    // full, quick, stealth, compliance
  triggeredBy     String        @default("manual") // manual, scheduled, api, webhook
  triggeredById   String?
  riskScore       Int           @default(0)
  totalVulns      Int           @default(0)
  criticalCount   Int           @default(0)
  highCount       Int           @default(0)
  mediumCount     Int           @default(0)
  lowCount        Int           @default(0)
  infoCount       Int           @default(0)
  complianceScore Int           @default(0)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  duration        Int?          // scan duration in ms
  findings        Finding[]
}

model Finding {
  id            String   @id @default(cuid())
  scanId        String
  scan          Scan     @relation(fields: [scanId], references: [id])
  title         String
  severity      String   // critical, high, medium, low, info
  category      String   // subdomain, port, technology, ssl, dns, header, vulnerability
  description   String
  evidence      String?
  asset         String
  remediation  String?  // fix guidance
  cve           String?  // CVE ID if applicable
  cvss          Float?   // CVSS score
  status        String   @default("open") // open, acknowledged, mitigated, false_positive
  createdAt     DateTime @default(now())
}

model ThreatAlert {
  id          String   @id @default(cuid())
  title       String
  severity    String
  source      String
  description String
  ioc         String?
  createdAt   DateTime @default(now())
}

// ── Compliance Framework ──────────────────────────────────────────

model ComplianceReport {
  id              String   @id @default(cuid())
  organizationId  String
  framework       String  // soc2, hipaa, pci_dss, iso27001, gdpr, nist
  scanId          String?
  overallScore    Int     @default(0) // 0-100
  status          String  @default("in_progress") // pass, fail, in_progress, needs_review
  controls        String  @default("[]") // JSON array of control checks
  generatedAt     DateTime @default(now())
}

// ── Continuous Monitoring ────────────────────────────────────────────

model MonitorPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  targetId       String
  target         ScanTarget  @relation(fields: [targetId], references: [id])
  name           String
  schedule       String      @default("daily") // hourly, daily, weekly, monthly
  scanType       String      @default("full")
  enabled        Boolean     @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  totalRuns      Int          @default(0)
  createdAt      DateTime    @default(now())
}

// ── Integrations ───────────────────────────────────────────────────

model Integration {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String        // slack, jira, splunk, pagerduty, microsoft_teams, webhooks, email
  name           String
  config         String        // JSON config
  enabled        Boolean       @default(true)
  lastSync       DateTime?
  eventsTotal    Int           @default(0)
  createdAt      DateTime      @default(now())
}

// ── API Key Management ──────────────────────────────────────────────

model ApiKey {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyHash        String      @unique  // SHA-256 hash of the API key
  keyPrefix      String              // First 12 chars for display (e.g., "rp_sk_live_")
  name           String              // Human-readable label
  scopes         String      @default("[\"scan:read\",\"scan:write\",\"telemetry:write\"]")  // JSON array
  lastUsedAt     DateTime?
  requestCount   Int         @default(0)
  isActive       Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  auditLogs      AuditLog[]
}

// ── Audit & Governance ──────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  memberId       String?
  member         Member?     @relation(fields: [memberId], references: [id])
  apiKeyId       String?
  apiKey         ApiKey?     @relation(fields: [apiKeyId], references: [id])
  action         String      // scan_launched, finding_acknowledged, member_invited, etc.
  resource       String      // scan, finding, member, team, policy
  resourceId     String?
  details        String?     // JSON
  ipAddress      String?
  createdAt      DateTime    @default(now())
}
