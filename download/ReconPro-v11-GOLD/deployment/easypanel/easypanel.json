{
  "projectName": "reconpro",
  "services": [
    {
      "name": "web",
      "source": {
        "image": "node:20-alpine",
        "buildCommand": "npm ci && npm run build"
      },
      "ports": [
        {
          "port": 3000,
          "protocol": "http"
        }
      ],
      "env": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "DATABASE_URL",
          "value": "file:/app/db/reconpro.db"
        }
      ]
    }
  ]
}